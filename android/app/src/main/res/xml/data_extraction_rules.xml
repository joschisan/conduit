<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ reads these rules instead of allowBackup/fullBackupContent.
     Exclude every domain from both cloud backup and device-to-device
     transfer so the wallet database (which contains the seed entropy) never
     leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
